# Production: use a server-only managed PostgreSQL connection (pooled URL on Vercel).
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://www.voss.pk
# Enable only after database setup, approved payment/delivery terms, and a test order.
VOSS_CHECKOUT_ENABLED=false
VOSS_PAYMENT_METHOD=cod
VOSS_DELIVERY_FEE_PKR=
# Blank fee = first 30 free orders only; later orders require manual delivery confirmation.
# Set a fixed fee only after the owner approves a single checkout rate.
VOSS_DELIVERY_CITY=Lahore
# Local development only; disabled automatically in production.
VOSS_LOCAL_DATABASE=1
